######################################################################################################################################
# 外部覆盖配置模板                                                                                                                    #
#                                                                                                                                     #
# 用法：复制为同目录下的 local.ini 后修改；config/*.ini 已在 .gitignore 中忽略，不会误入库。                                          #
# 只需写需要覆盖的键，未写的键沿用 jar 内 classpath:config/*.ini 的默认值。                                                           #
# 键名必须与 ini 中完全一致(带前缀)，例如 db.url、sys.ServerUrl、smtp.host。                                                          #
#                                                                                                                                     #
# 三层覆盖顺序(后者覆盖前者)：                                                                                                        #
#   classpath:config/*.ini  ->  ./config/*.ini  ->  ./config/{env}/*.ini                                                              #
# 环境名 env 取值优先级：-Dcdtest.env  >  环境变量 CDTEST_ENV  >  本文件中的 sys.env                                                  #
# 配置目录默认为启动目录下的 config，可用 -Dcdtest.config.dir 指定。                                                                  #
#                                                                                                                                     #
# 口令不要写在本文件里：db.password/smtp.password/sys.JKS_PWD 由环境变量                                                     #
# CDTEST_DB_PASSWORD / CDTEST_SMTP_PASSWORD / CDTEST_JKS_PASSWORD 提供。                                                              #
######################################################################################################################################

#当前环境名，对应 config/{env}/ 覆盖目录                                                                                             #
#sys.env=test

#数据库地址(示例，按实际环境填写)                                                                                                    #
#db.url=jdbc:oracle:thin:@10.0.0.1:1521:orcl
#db.username=AutoTest

#被测系统首页                                                                                                                        #
#sys.ServerUrl=https://bip-pre.yonyoucloud.com/#/

#邮件服务器                                                                                                                          #
#smtp.host=
#smtp.account=
######################################################################################################################################
